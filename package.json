{
  "name": "search-next-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.23.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter search-next-web dev",
    "dev:admin": "pnpm --filter search-next-admin dev",
    "dev:api": "pnpm --filter search-next-api start:dev",
    "dev:local": "pnpm --filter search-next-web dev:local",
    "dev:prod": "pnpm --filter search-next-web dev:prod",
    "build": "pnpm --filter search-next-web build",
    "build:admin": "pnpm --filter search-next-admin build",
    "build:api": "pnpm --filter search-next-api build",
    "build:local": "pnpm --filter search-next-web build:local",
    "build:prod": "pnpm --filter search-next-web build:prod",
    "preview": "pnpm --filter search-next-web preview",
    "preview:local": "pnpm --filter search-next-web preview:local",
    "preview:prod": "pnpm --filter search-next-web preview:prod",
    "dev:docs": "pnpm --filter search-next-docs dev",
    "build:docs": "pnpm --filter search-next-docs build",
    "widget:create": "node scripts/create-widget.mjs",
    "widget:pack": "node scripts/pack-widget.mjs",
    "widget:screenshots": "node scripts/capture-widget-screenshots.mjs",
    "widget:pack:clock": "node scripts/pack-widget.mjs clock",
    "widget:pack:todo": "node scripts/pack-widget.mjs todo",
    "build:widgets": "pnpm --filter './apps/widgets/*' build",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.7.2",
    "vite": "^7.1.12"
  }
}
