{
  "name": "search-next-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.23.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter search-next-web dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:admin": "pnpm --filter search-next-admin dev",
    "dev:api": "pnpm --filter search-next-api start:dev",
    "dev:local": "pnpm --filter search-next-web dev:local",
    "dev:prod": "pnpm --filter search-next-web dev:prod",
    "build": "pnpm --filter search-next-web build",
    "build:admin": "pnpm --filter search-next-admin build",
    "build:api": "pnpm --filter search-next-api build",
    "build:local": "pnpm --filter search-next-web build:local",
    "build:prod": "pnpm --filter search-next-web build:prod",
    "preview": "pnpm --filter search-next-web preview",
    "preview:local": "pnpm --filter search-next-web preview:local",
    "preview:prod": "pnpm --filter search-next-web preview:prod",
    "dev:docs": "pnpm --filter search-next-docs dev",
    "build:docs": "pnpm --filter search-next-docs build",
    "deploy:docs": "npx wrangler deploy --config apps/docs/wrangler.jsonc",
    "build:all": "pnpm build:api && pnpm build:prod && pnpm build:admin && pnpm build:docs && pnpm build:apps",
    "app:create": "node scripts/create-app.mjs",
    "app:pack": "node scripts/pack-app.mjs",
    "app:pack:all": "node scripts/pack-app.mjs --all",
    "app:screenshots": "node scripts/capture-app-screenshots.mjs",
    "app:pack:clock": "node scripts/pack-app.mjs clock",
    "app:pack:todo": "node scripts/pack-app.mjs todo",
    "wallpaper:pack": "node scripts/pack-wallpaper.mjs",
    "wallpaper:pack:all": "node scripts/pack-wallpaper.mjs --all",
    "wallpaper:pack:migration": "node scripts/pack-wallpaper.mjs migration-open-source",
    "build:apps": "pnpm --filter './apps/apps/*' build",
    "release": "node scripts/release.cjs release",
    "release:changes": "node scripts/release.cjs changes",
    "release:dry": "node scripts/release.cjs dry",
    "release:notes": "node scripts/release-assets.mjs notes",
    "release:prepare": "node scripts/release-assets.mjs prepare",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "release-it": "^20.2.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.7.2",
    "vite": "^7.1.12"
  }
}
