{
  "schemaVersion": "1.0.0",
  "name": "memo",
  "displayName": "备忘录",
  "version": "0.1.0",
  "description": "Apple Notes 风格本地备忘录小组件，支持置顶、搜索和清单",
  "author": "Search-Next",
  "entry": "index.js",
  "icon": "icon.svg",
  "tags": ["工具", "备忘录", "Notes", "本地"],
  "sizeConfigs": [
    { "row": 1, "col": 1, "name": "1x1", "id": "1x1" },
    { "row": 1, "col": 2, "name": "2x1", "id": "2x1" },
    { "row": 2, "col": 2, "name": "2x2", "id": "2x2" },
    { "row": 2, "col": 4, "name": "4x2", "id": "4x2" }
  ],
  "defaultSizeId": "2x2",
  "supportIconMode": true,
  "supportAppMode": true,
  "appIcon": { "type": "image", "src": "icon.svg" },
  "pagePaths": {
    "settings": "/settings"
  },
  "settingsSchema": [
    {
      "key": "defaultColor",
      "label": "默认颜色",
      "type": "select",
      "default": "yellow",
      "options": [
        { "label": "黄色", "value": "yellow" },
        { "label": "白色", "value": "white" },
        { "label": "蓝色", "value": "blue" },
        { "label": "绿色", "value": "green" }
      ]
    },
    {
      "key": "sortMode",
      "label": "排序方式",
      "type": "select",
      "default": "updated",
      "options": [
        { "label": "最近编辑", "value": "updated" },
        { "label": "标题", "value": "title" }
      ]
    },
    {
      "key": "showChecklist",
      "label": "显示清单",
      "type": "switch",
      "default": true
    }
  ]
}
