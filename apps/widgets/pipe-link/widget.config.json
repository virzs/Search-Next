{
  "name": "pipe-link",
  "displayName": "终端回路",
  "version": "0.1.0",
  "description": "接入所有信标，避开故障节点，重构通往终端的 2D 回路解谜游戏",
  "author": "Search-Next",
  "entry": "index.js",
  "icon": "icon.svg",
  "tags": ["游戏", "解谜", "管道", "键盘"],
  "sizeConfigs": [
    { "row": 1, "col": 1, "name": "1x1", "id": "1x1" }
  ],
  "defaultSizeId": "1x1",
  "supportIconMode": false,
  "supportAppMode": true,
  "appIcon": { "type": "image", "src": "icon.svg" },
  "settingsSchema": [
    {
      "key": "showHints",
      "label": "显示键盘提示",
      "type": "switch",
      "default": true,
      "description": "在设置页显示 WASD / 方向键说明"
    },
    {
      "key": "animation",
      "label": "动画强度",
      "type": "select",
      "default": "normal",
      "description": "控制路径高亮和管道脉冲动画",
      "options": [
        { "label": "低", "value": "low" },
        { "label": "标准", "value": "normal" },
        { "label": "高", "value": "high" }
      ]
    }
  ]
}
