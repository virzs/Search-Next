{
  "name": "calendar",
  "displayName": "日历",
  "displayNameI18n": {
    "zh-CN": "日历",
    "en-US": "Calendar"
  },
  "version": "0.1.0",
  "description": "iPadOS 风格日历小组件，支持月视图、今日日程和显示偏好",
  "descriptionI18n": {
    "zh-CN": "iPadOS 风格日历小组件，支持月视图、今日日程和显示偏好",
    "en-US": "iPadOS-style calendar widget with month view, today's agenda, and display preferences"
  },
  "author": "Search-Next",
  "entry": "index.js",
  "icon": "icon.svg",
  "tags": ["工具", "日历", "日程", "iPadOS"],
  "tagsI18n": {
    "zh-CN": ["工具", "日历", "日程", "iPadOS"],
    "en-US": ["Tools", "Calendar", "Agenda", "iPadOS"]
  },
  "sizeConfigs": [
    { "row": 2, "col": 2, "name": "2x2", "id": "2x2" },
    { "row": 2, "col": 4, "name": "4x2", "id": "4x2" },
    { "row": 2, "col": 3, "name": "3x2", "id": "3x2" },
    { "row": 1, "col": 2, "name": "2x1", "id": "2x1" },
    { "row": 1, "col": 1, "name": "1x1", "id": "1x1" }
  ],
  "defaultSizeId": "2x2",
  "supportIconMode": true,
  "supportAppMode": true,
  "appIcon": { "type": "image", "src": "icon.svg" },
  "pagePaths": {
    "settings": "/settings"
  },
  "settingsSchema": [
    {
      "key": "weekStart",
      "label": "周起始日",
      "type": "select",
      "default": "sun",
      "description": "选择月视图每周从周日或周一开始",
      "options": [
        { "label": "周日", "value": "sun" },
        { "label": "周一", "value": "mon" }
      ]
    },
    {
      "key": "accentColor",
      "label": "强调色",
      "type": "select",
      "default": "#0071e3",
      "description": "用于今天高亮和事件标记",
      "options": [
        { "label": "蓝色", "value": "#0071e3" },
        { "label": "绿色", "value": "#16a34a" },
        { "label": "红色", "value": "#dc2626" },
        { "label": "琥珀", "value": "#f59e0b" },
        { "label": "紫色", "value": "#8b5cf6" },
        { "label": "青色", "value": "#06b6d4" }
      ]
    },
    {
      "key": "eventDensity",
      "label": "事件密度",
      "type": "select",
      "default": "normal",
      "description": "控制日程列表显示的信息密度",
      "options": [
        { "label": "紧凑", "value": "compact" },
        { "label": "标准", "value": "normal" },
        { "label": "详细", "value": "detailed" }
      ]
    }
  ]
}
