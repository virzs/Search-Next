{
  "name": "search-next-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:local": "dotenv -e local.env -- vite --host",
    "dev:prod": "dotenv -e prod.env -- vite --host",
    "build": "tsc -b && vite build",
    "build:local": "dotenv -e local.env -- tsc -b && vite build",
    "build:prod": "dotenv -e prod.env -- tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:local": "dotenv -e local.env -- vite preview",
    "preview:prod": "dotenv -e prod.env -- vite preview"
  },
  "dependencies": {
    "@ant-design/x": "^2.1.3",
