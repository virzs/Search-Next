    "@search-next/desktop": "workspace:*",
    "@tailwindcss/vite": "^4.1.4",
    "ahooks": "^3.8.4",
    "antd": "^6.1.3",
    "axios": "^1.9.0",
    "boring-avatars": "^2.0.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.12.1",
    "i18next": "^24.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.4.6",
    "react-i18next": "^15.7.4",
